# Copy thanh infra/.env roi sua. File .env KHONG dua len git.

# Database
POSTGRES_USER=labuser
POSTGRES_PASSWORD=labpass
POSTGRES_DB=labdb

# Hai ten mien. Chay tren may: *.localhost tu tro ve may minh, khong can sua file hosts.
SITE_HOST=daliang.localhost
# Cong noi bo: dat ten KHO DOAN, khong chua chu "admin" (vd noibo-7k2x.daliang.com)
PORTAL_HOST=noibo.daliang.localhost

# Dang nhap - BAT BUOC dat JWT_SECRET khi chay that (chuoi ngau nhien dai):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Quen mat khau - gui mail qua Resend (https://resend.com), de trong thi in link ra log backend
RESEND_API_KEY=
MAIL_FROM=Daliang VN <noreply@daliang.com>
# Goc URL cong noi bo, de ghep link dat lai mat khau trong email
PORTAL_URL=http://noibo.daliang.localhost
