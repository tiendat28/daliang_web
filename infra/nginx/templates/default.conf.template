# nginx tu thay ${SITE_HOST} / ${PORTAL_HOST} tu bien moi truong luc khoi dong.
# Luc dev hai app la Vite dev server nen phai cho qua websocket (HMR).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Website cong khai
server {
    listen 80;
    server_name ${SITE_HOST};
    client_max_body_size 25m;

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://landing:5174;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
    }
}

# Cong noi bo - subdomain kho doan, khong cho may tim kiem lap chi muc
server {
    listen 80;
    server_name ${PORTAL_HOST};
    client_max_body_size 25m;
    add_header X-Robots-Tag "noindex, nofollow" always;

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://portal:5173;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
    }
}
